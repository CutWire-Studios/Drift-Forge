    {
      "path": "pass1.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float focus;
uniform float blurAmount;
float pv_focus() { return focus; }
float pv_blurAmount() { return blurAmount; }

float n_#2_t(vec2 uv) {
    float ang = radians(90.0);
    vec2 d = vec2(cos(ang), sin(ang));
    float t = clamp(dot(uv - 0.5, d) / max(abs(d.x) + abs(d.y), 0.0001) + 0.5, 0.0, 1.0);
    return t;
}

float n_#3_value(vec2 uv) {
    return n_#2_t(uv) - pv_focus();
}

float n_#4_value(vec2 uv) {
    return abs(n_#3_value(uv));
}

float n_#5_value(vec2 uv) {
    float t = clamp((n_#4_value(uv) - 0.08) / (0.4 - 0.08 + 1e-6), 0.0, 1.0);
    return mix(0.0, pv_blurAmount(), t);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 s_#6_0(vec2 uv) {
    float r = max(n_#5_value(uv), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(1.0, 0.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += n_#1_image(uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#6_0(v_texCoord);
}
",
    },
    {
      "path": "pass2.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float focus;
uniform float blurAmount;
float pv_focus() { return focus; }
float pv_blurAmount() { return blurAmount; }

float n_#2_t(vec2 uv) {
    float ang = radians(90.0);
    vec2 d = vec2(cos(ang), sin(ang));
    float t = clamp(dot(uv - 0.5, d) / max(abs(d.x) + abs(d.y), 0.0001) + 0.5, 0.0, 1.0);
    return t;
}

float n_#3_value(vec2 uv) {
    return n_#2_t(uv) - pv_focus();
}

float n_#4_value(vec2 uv) {
    return abs(n_#3_value(uv));
}

float n_#5_value(vec2 uv) {
    float t = clamp((n_#4_value(uv) - 0.08) / (0.4 - 0.08 + 1e-6), 0.0, 1.0);
    return mix(0.0, pv_blurAmount(), t);
}

vec4 s_#6_1(vec2 uv) {
    float r = max(n_#5_value(uv), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(0.0, 1.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#6_1(v_texCoord);
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

vec4 n_#6_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#7_image(vec2 uv) {
    vec4 col = n_#6_image(uv);
    vec3 rgb = mix(vec3(luma(col)), col.rgb, 1.3);
    return vec4(clamp(rgb, 0.0, 1.0), col.a);
}

void main() {
    fragColor = n_#7_image(v_texCoord);
}
",
