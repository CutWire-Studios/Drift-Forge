    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform vec2 u_resolution;
uniform float u_progress;
uniform float punch;
uniform float split;
uniform float holdUntil;
float pv_punch() { return punch; }
float pv_split() { return split; }
float pv_holdUntil() { return holdUntil; }

float n_#4_value(vec2 uv) {
    return u_progress;
}

float n_#6_value(vec2 uv) {
    float t = clamp(n_#4_value(uv), 0.0, 1.0);
    return sin(t * 3.14159265);
}

float n_#8_value(vec2 uv) {
    return n_#6_value(uv) * pv_split();
}

float n_#7_value(vec2 uv) {
    return n_#6_value(uv) * pv_punch();
}

vec4 n_#10_image(vec2 uv) {
    vec2 ctr = vec2(0.5, 0.5);
    vec4 sum = vec4(0.0);
    for (int k = 0; k < 24; ++k) {
        float s = 1.0 - n_#7_value(uv) * float(k) / 23.0;
        sum += texture(u_currentTexture, ctr + (uv - ctr) * s);
    }
    return sum / 24.0;
}

vec4 n_#11_image(vec2 uv) {
    float a = radians(0.0);
    vec2 delta = vec2(cos(a), sin(a)) * n_#8_value(uv) / u_resolution;
    vec4 g = n_#10_image(uv);
    float r = n_#10_image(clamp(uv + delta, 0.0, 1.0)).r;
    float b = n_#10_image(clamp(uv - delta, 0.0, 1.0)).b;
    return vec4(r, g.g, b, g.a);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#3_mask(vec2 uv) {
    return driftMask(uv);
}

float n_#12_value(vec2 uv) {
    return smoothstep(pv_holdUntil(), max(1.0, pv_holdUntil() + 1e-5), n_#4_value(uv));
}

float n_#13_value(vec2 uv) {
    return 1.0 - n_#12_value(uv);
}

float n_#14_value(vec2 uv) {
    return n_#3_mask(uv) * n_#13_value(uv);
}

vec4 n_#15_image(vec2 uv) {
    return mix(n_#11_image(uv), n_#1_image(uv), clamp(n_#14_value(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#15_image(v_texCoord);
}
",
