    {
      "path": "pass1.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float auraSize;
float pv_auraSize() { return auraSize; }

float n_#2_mask(vec2 uv) {
    return driftMask(uv);
}

vec4 s_#3_0(vec2 uv) {
    float r = max(pv_auraSize(), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(1.0, 0.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += vec4(vec3(n_#2_mask(uv + texel * o)), 1.0) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#3_0(v_texCoord);
}
",
    },
    {
      "path": "pass2.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float auraSize;
float pv_auraSize() { return auraSize; }

vec4 s_#3_1(vec2 uv) {
    float r = max(pv_auraSize(), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(0.0, 1.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#3_1(v_texCoord);
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform vec2 u_resolution;
uniform float u_time;
uniform float rings;
uniform float ringSpeed;
uniform float refraction;
uniform vec3 auraColor;
uniform float auraGlow;
float pv_rings() { return rings; }
float pv_ringSpeed() { return ringSpeed; }
float pv_refraction() { return refraction; }
vec3 pv_auraColor() { return auraColor; }
float pv_auraGlow() { return auraGlow; }

mat2 rot2(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat2(c, s, -s, c);
}

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec2 n_#19_uv(vec2 uv) {
    return uv;
}

vec4 n_#3_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#4_r(vec2 uv) {
    return n_#3_image(uv).r;
}

vec2 n_#16_grad(vec2 uv) {
    vec2 h = max(2.0, 0.01) / u_resolution;
    vec2 g = vec2(n_#4_r(uv + vec2(h.x, 0.0)) - n_#4_r(uv + vec2(-h.x, 0.0)), n_#4_r(uv + vec2(0.0, h.y)) - n_#4_r(uv + vec2(0.0, -h.y))) / (2.0 * h);
    return g;
}

float n_#5_value(vec2 uv) {
    return n_#4_r(uv) * pv_rings();
}

float n_#6_value(vec2 uv) {
    return u_time * pv_ringSpeed();
}

float n_#7_value(vec2 uv) {
    return n_#5_value(uv) + n_#6_value(uv);
}

float n_#8_value(vec2 uv) {
    return fract(n_#7_value(uv));
}

float n_#9_value(vec2 uv) {
    return n_#8_value(uv) - 0.5;
}

float n_#10_value(vec2 uv) {
    return abs(n_#9_value(uv));
}

float n_#11_value(vec2 uv) {
    return smoothstep(0.36, max(0.5, 0.36 + 1e-5), n_#10_value(uv));
}

float n_#12_value(vec2 uv) {
    return smoothstep(0.02, max(0.3, 0.02 + 1e-5), n_#4_r(uv));
}

float n_#2_mask(vec2 uv) {
    return driftMask(uv);
}

float n_#13_value(vec2 uv) {
    return 1.0 - n_#2_mask(uv);
}

float n_#14_value(vec2 uv) {
    return n_#12_value(uv) * n_#13_value(uv);
}

float n_#15_value(vec2 uv) {
    return n_#11_value(uv) * n_#14_value(uv);
}

float n_#17_value(vec2 uv) {
    return n_#15_value(uv) * pv_refraction();
}

vec2 n_#18_p(vec2 uv) {
    return n_#16_grad(uv) * n_#17_value(uv);
}

vec2 n_#20_p(vec2 uv) {
    return n_#19_uv(uv) + n_#18_p(uv);
}

vec4 n_#21_image(vec2 uv) {
    vec2 p = n_#20_p(uv);
    return n_#1_image(clamp(p, 0.0, 1.0));
}

vec4 n_#22_image(vec2 uv) {
    return mix(vec4(0.0, 0.0, 0.0, 1.0), vec4(pv_auraColor(), 1.0), clamp(n_#15_value(uv), 0.0, 1.0));
}

vec4 n_#23_image(vec2 uv) {
    vec4 b = n_#21_image(uv);
    vec4 l = n_#22_image(uv);
    vec3 rgb = 1.0 - (1.0 - b.rgb) * (1.0 - l.rgb);
    return vec4(mix(b.rgb, rgb, clamp(pv_auraGlow() * l.a, 0.0, 1.0)), b.a);
}

vec4 n_#24_image(vec2 uv) {
    return mix(n_#23_image(uv), n_#1_image(uv), clamp(n_#2_mask(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#24_image(v_texCoord);
}
",
    },
