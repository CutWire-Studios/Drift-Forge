    float v = smoothstep(0.75 - 0.45, 0.75, length(d) * 1.2);
    return vec4(mix(col.rgb, vec4(0.0, 0.0, 0.0, 1.0).rgb, v * 0.7), col.a);
}

void main() {
    fragColor = n_#5_image(v_texCoord);
