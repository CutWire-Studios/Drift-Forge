    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform vec2 u_resolution;
uniform float u_progress;
uniform float twist;
float pv_twist() { return twist; }

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec2 x_#7cmul(vec2 a, vec2 b) { return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x); }
vec2 x_#7cdiv(vec2 a, vec2 b) { float d = max(dot(b, b), 1e-8); return vec2(a.x * b.x + a.y * b.y, a.y * b.x - a.x * b.y) / d; }

float n_#3_value(vec2 uv) {
    return u_progress;
}

float n_#4_value(vec2 uv) {
    float t = clamp(n_#3_value(uv), 0.0, 1.0);
    return sin(t * 3.14159265);
}

float n_#5_value(vec2 uv) {
    return n_#4_value(uv) * pv_twist();
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) + 1.0;
}

vec2 n_#7_p(vec2 uv) {
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 sc = vec2(asp, -1.0) * 2.0;
    vec2 z = (uv - 0.5) * sc;
    vec2 w = vec2(1.0, 0.0);
    float n = n_#6_value(uv);
    vec2 r = pow(max(length(z), 1e-8), n) * vec2(cos(n * atan(z.y, z.x)), sin(n * atan(z.y, z.x)));
    return r / sc + 0.5;
}

vec4 n_#8_image(vec2 uv) {
    vec2 p = n_#7_p(uv);
    return n_#1_image(1.0 - abs(mod(p, 2.0) - 1.0));
}

vec4 n_#2_image(vec2 uv) {
    return texture(u_texture1, uv);
}

vec4 n_#9_image(vec2 uv) {
    vec2 p = n_#7_p(uv);
    return n_#2_image(1.0 - abs(mod(p, 2.0) - 1.0));
}

float n_#10_value(vec2 uv) {
    float t = clamp(n_#3_value(uv), 0.0, 1.0);
    return t < 0.5 ? 4.0 * t * t * t : 1.0 - pow(-2.0 * t + 2.0, 3.0) / 2.0;
}

vec4 n_#11_image(vec2 uv) {
    return mix(n_#8_image(uv), n_#9_image(uv), clamp(n_#10_value(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#11_image(v_texCoord);
}
