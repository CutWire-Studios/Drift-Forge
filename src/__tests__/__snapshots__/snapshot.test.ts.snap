  "files": [
    {
      "path": "effect.json",
      "text": "{
  "id": "#0",
  "displayName": "Vortex backdrop",
  "category": "dreamy",
  "order": 1000,
  "description": "The background twists into a whirlpool around the person. The Jacobian's curl lights up where it spins hardest.",
  "backend": "gpu",
  "requires": "mask",
  "parameters": [
    {
      "identifier": "vortexSize",
      "displayName": "Size",
      "type": "float",
      "minValue": 0.1,
      "maxValue": 1.5,
      "defaultValue": 0.45
    },
    {
      "identifier": "vortexSpeed",
      "displayName": "Speed",
      "type": "float",
      "minValue": 0,
      "maxValue": 2,
      "defaultValue": 0.2
    },
    {
      "identifier": "twist",
      "displayName": "Twist (°)",
      "type": "float",
      "minValue": 0,
      "maxValue": 720,
      "defaultValue": 240
    },
    {
      "identifier": "swirlColor",
      "displayName": "Swirl light",
      "type": "color",
      "defaultValue": "#8a6bff"
    },
    {
      "identifier": "swirlGlow",
      "displayName": "Swirl glow",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.6
    }
  ],
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [
          {
            "type": "source_texture"
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  },
  "nextFeatures": [
    "node:clip_mask",
    "requires:mask"
  ]
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float u_time;
uniform float vortexSize;
uniform float vortexSpeed;
uniform float twist;
uniform vec3 swirlColor;
uniform float swirlGlow;
float pv_vortexSize() { return vortexSize; }
float pv_vortexSpeed() { return vortexSpeed; }
float pv_twist() { return twist; }
vec3 pv_swirlColor() { return swirlColor; }
float pv_swirlGlow() { return swirlGlow; }

mat2 rot2(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat2(c, s, -s, c);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec2 n_#3_uv(vec2 uv) {
    return uv;
}

vec2 n_#4_p(vec2 uv) {
    return n_#3_uv(uv) - vec2(0.5, 0.5);
}

float n_#5_length(vec2 uv) {
    return length(n_#4_p(uv));
}

float n_#6_value(vec2 uv) {
    return n_#5_length(uv) / (abs(pv_vortexSize()) < 1e-6 ? 1e-6 : pv_vortexSize());
}

float n_#7_value(vec2 uv) {
    return n_#6_value(uv) * n_#6_value(uv);
}

float n_#8_value(vec2 uv) {
    return -n_#7_value(uv);
}

float n_#9_value(vec2 uv) {
    return exp(min(n_#8_value(uv), 80.0));
}

float n_#10_value(vec2 uv) {
    float x = u_time * pv_vortexSpeed() + 0.0;
    return mix(-1.0, 1.0, 0.5 - 0.5 * cos(x * 6.2832));
}

float n_#11_value(vec2 uv) {
    return n_#10_value(uv) * pv_twist();
}

float n_#12_value(vec2 uv) {
    return n_#9_value(uv) * n_#11_value(uv);
}

vec2 n_#13_p(vec2 uv) {
    return rot2(radians(n_#12_value(uv))) * n_#4_p(uv);
}

vec2 n_#14_p(vec2 uv) {
    return n_#13_p(uv) + vec2(0.5, 0.5);
}

vec4 n_#15_image(vec2 uv) {
    vec2 p = n_#14_p(uv);
    return n_#1_image(1.0 - abs(mod(p, 2.0) - 1.0));
}

float n_#16_curl(vec2 uv) {
    vec2 h = max(2.0, 0.01) / u_resolution;
    vec2 jx = (n_#14_p((uv + vec2(h.x, 0.0))) - n_#14_p((uv + vec2(-h.x, 0.0)))) / (2.0 * h.x);
    vec2 jy = (n_#14_p((uv + vec2(0.0, h.y))) - n_#14_p((uv + vec2(0.0, -h.y)))) / (2.0 * h.y);
    return jx.y - jy.x;
}

float n_#17_value(vec2 uv) {
    return abs(n_#16_curl(uv));
}

float n_#18_value(vec2 uv) {
    float t = clamp((n_#17_value(uv) - 0.0) / (4.0 - 0.0 + 1e-6), 0.0, 1.0);
    return mix(0.0, 1.0, t);
}

vec4 n_#19_image(vec2 uv) {
    return mix(vec4(0.0, 0.0, 0.0, 1.0), vec4(pv_swirlColor(), 1.0), clamp(n_#18_value(uv), 0.0, 1.0));
}

vec4 n_#20_image(vec2 uv) {
    vec4 b = n_#15_image(uv);
    vec4 l = n_#19_image(uv);
    vec3 rgb = 1.0 - (1.0 - b.rgb) * (1.0 - l.rgb);
    return vec4(mix(b.rgb, rgb, clamp(pv_swirlGlow() * l.a, 0.0, 1.0)), b.a);
}

float n_#2_mask(vec2 uv) {
    return driftMask(uv);
}

vec4 n_#21_image(vec2 uv) {
    return mix(n_#20_image(uv), n_#1_image(uv), clamp(n_#2_mask(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#21_image(v_texCoord);
}
",
    },
