    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float u_time;
uniform float wander;
uniform float drift;
uniform float zoom;
float pv_wander() { return wander; }
float pv_drift() { return drift; }
float pv_zoom() { return zoom; }

mat2 rot2(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat2(c, s, -s, c);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec2 x_#6cmul(vec2 a, vec2 b) { return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x); }
vec2 x_#6cdiv(vec2 a, vec2 b) { float d = max(dot(b, b), 1e-8); return vec2(a.x * b.x + a.y * b.y, a.y * b.x - a.x * b.y) / d; }

float n_#2_value(vec2 uv) {
    float x = u_time * pv_drift() + 0.0;
    return mix(-1.0, 1.0, 0.5 - 0.5 * cos(x * 6.2832));
}

float n_#3_value(vec2 uv) {
    float x = u_time * pv_drift() + 0.25;
    return mix(-1.0, 1.0, 0.5 - 0.5 * cos(x * 6.2832));
}

vec2 n_#4_p(vec2 uv) {
    return vec2(n_#2_value(uv), n_#3_value(uv));
}

vec2 n_#5_p(vec2 uv) {
    return n_#4_p(uv) * pv_wander();
}

vec2 n_#6_p(vec2 uv) {
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 sc = vec2(asp, -1.0) * pv_zoom();
    vec2 z = (uv - 0.5) * sc;
    vec2 w = n_#5_p(uv);
    float n = 2.0;
    vec2 r = x_#6cdiv(z - w, vec2(1.0, 0.0) - x_#6cmul(vec2(w.x, -w.y), z));
    return r / sc + 0.5;
}

vec4 n_#7_image(vec2 uv) {
    vec2 p = n_#6_p(uv);
    return n_#1_image(1.0 - abs(mod(p, 2.0) - 1.0));
}

void main() {
    fragColor = n_#7_image(v_texCoord);
}
",
