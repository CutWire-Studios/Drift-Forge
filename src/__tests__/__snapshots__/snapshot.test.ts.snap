      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float u_time;
uniform float glitch;
uniform float split;
float pv_glitch() { return glitch; }
float pv_split() { return split; }

float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#2_image(vec2 uv) {
    float tick = floor(u_time * 12.0) + 0.0 * 31.7;
    float row = floor(uv.y * 24.0);
    float h = hash21(vec2(row, tick));
    float on = step(1.0 - pv_glitch() * 0.6, h);
    float shift = (hash21(vec2(tick, row * 1.7)) - 0.5) * 0.25 * pv_glitch() * on;
    vec2 p = vec2(fract(uv.x + shift), uv.y);
    vec4 g = n_#1_image(p);
    float r = n_#1_image(vec2(fract(p.x + shift * 0.3), p.y)).r;
    float b = n_#1_image(vec2(fract(p.x - shift * 0.3), p.y)).b;
    return vec4(r, g.g, b, g.a);
}

vec4 n_#3_image(vec2 uv) {
    float a = radians(0.0);
    vec2 delta = vec2(cos(a), sin(a)) * pv_split() / u_resolution;
    vec4 g = n_#2_image(uv);
    float r = n_#2_image(clamp(uv + delta, 0.0, 1.0)).r;
    float b = n_#2_image(clamp(uv - delta, 0.0, 1.0)).b;
    return vec4(r, g.g, b, g.a);
}

vec4 n_#4_image(vec2 uv) {
    vec4 col = n_#3_image(uv);
    float l = 0.5 + 0.5 * sin((uv.y + u_time * 0.0 * 0.05) * 240.0 * 3.14159);
    return vec4(col.rgb * (1.0 - 0.15 * (1.0 - l)), col.a);
}

void main() {
    fragColor = n_#4_image(v_texCoord);
}
