  "files": [
    {
      "path": "transition.json",
      "text": "{
  "id": "#0",
  "displayName": "Sticker fling",
  "category": "stylized",
  "order": 1000,
  "description": "The person peels off as a white-bordered sticker and spins away off the top of the frame, uncovering the next clip.",
  "audioCurve": "crossfade",
  "requires": "mask",
  "parameters": [
    {
      "identifier": "spin",
      "displayName": "Spin (°)",
      "type": "float",
      "minValue": -180,
      "maxValue": 180,
      "defaultValue": 35
    },
    {
      "identifier": "flingSize",
      "displayName": "End size",
      "type": "float",
      "minValue": 0.5,
      "maxValue": 2,
      "defaultValue": 1.3
    },
    {
      "identifier": "border",
      "displayName": "Border (px)",
      "type": "float",
      "minValue": 2,
      "maxValue": 30,
      "defaultValue": 10
    },
    {
      "identifier": "borderColor",
      "displayName": "Border colour",
      "type": "color",
      "defaultValue": "#ffffff"
    }
  ],
  "pipeline": {
    "intermediateBuffers": [
      {
        "id": "buf0",
        "scale": 1
      },
      {
        "id": "buf1",
        "scale": 1
      },
      {
        "id": "buf2",
        "scale": 1
      }
    ],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "pass1.frag",
        "inputs": [
          {
            "type": "source_texture",
            "index": 0
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf0"
        }
      },
      {
        "passIndex": 1,
        "fragmentShader": "pass2.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "buf0"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf1"
        }
      },
      {
        "passIndex": 2,
        "fragmentShader": "pass3.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "buf1"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf2"
        }
      },
      {
        "passIndex": 3,
        "fragmentShader": "main.frag",
        "inputs": [
          {
            "type": "source_texture",
            "index": 0
          },
          {
            "type": "source_texture",
            "index": 1
          },
          {
            "type": "buffer",
            "id": "buf2"
          },
          {
            "type": "buffer",
            "id": "buf0"
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  },
  "nextFeatures": [
    "node:clip_mask",
    "requires:mask"
  ]
}
",
    },
    {
      "path": "pass1.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float u_progress;
uniform float spin;
uniform float flingSize;
float pv_spin() { return spin; }
float pv_flingSize() { return flingSize; }

float n_#3_mask(vec2 uv) {
    return driftMask(uv);
}

float n_#4_value(vec2 uv) {
    return u_progress;
}

float n_#5_value(vec2 uv) {
    float t = clamp(n_#4_value(uv), 0.0, 1.0);
    return t * t * t;
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) * pv_spin();
}

float n_#7_value(vec2 uv) {
    return n_#6_value(uv) * 0.017453;
}

float n_#8_value(vec2 uv) {
    return cos(n_#7_value(uv));
}

float n_#10_value(vec2 uv) {
    float t = clamp((n_#5_value(uv) - 0.0) / (1.0 - 0.0 + 1e-6), 0.0, 1.0);
    return mix(1.0, pv_flingSize(), t);
}

float n_#11_value(vec2 uv) {
    return n_#8_value(uv) * n_#10_value(uv);
}

float n_#9_value(vec2 uv) {
    return sin(n_#7_value(uv));
}

float n_#12_value(vec2 uv) {
    return n_#9_value(uv) * n_#10_value(uv);
}

float n_#13_value(vec2 uv) {
    return -n_#12_value(uv);
}

float n_#14_value(vec2 uv) {
    return n_#5_value(uv) * -0.25;
}

float n_#15_value(vec2 uv) {
    return n_#5_value(uv) * 1.4;
}

vec2 n_#16_p(vec2 uv) {
    return vec2(n_#14_value(uv), n_#15_value(uv));
}

vec2 n_#17_p(vec2 uv) {
    mat2 M = mat2(n_#11_value(uv), n_#12_value(uv), n_#13_value(uv), n_#11_value(uv));
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = vec2(0.5, 0.6);
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + n_#16_p(uv);
}

vec4 n_#19_image(vec2 uv) {
    vec2 p = n_#17_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return vec4(vec3(n_#3_mask(p)), 1.0);
}

void main() {
    fragColor = n_#19_image(v_texCoord);
}
",
    },
    {
      "path": "pass2.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float border;
float pv_border() { return border; }

vec4 s_#21_0(vec2 uv) {
    float r = max(pv_border(), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(1.0, 0.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#21_0(v_texCoord);
}
",
    },
    {
      "path": "pass3.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float border;
float pv_border() { return border; }

vec4 s_#21_1(vec2 uv) {
    float r = max(pv_border(), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(0.0, 1.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#21_1(v_texCoord);
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform sampler2D u_texture2;
uniform sampler2D u_texture3;
uniform vec2 u_resolution;
uniform float u_progress;
uniform float spin;
uniform float flingSize;
uniform vec3 borderColor;
float pv_spin() { return spin; }
float pv_flingSize() { return flingSize; }
vec3 pv_borderColor() { return borderColor; }

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#2_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#4_value(vec2 uv) {
    return u_progress;
}

float n_#26_value(vec2 uv) {
    return smoothstep(0.0, max(0.5, 0.0 + 1e-5), n_#4_value(uv));
}

vec4 n_#27_image(vec2 uv) {
    return mix(n_#1_image(uv), n_#2_image(uv), clamp(n_#26_value(uv), 0.0, 1.0));
}

vec4 n_#21_image(vec2 uv) {
    return texture(u_texture2, uv);
}

float n_#22_r(vec2 uv) {
    return n_#21_image(uv).r;
}

float n_#23_value(vec2 uv) {
    return smoothstep(0.03, max(0.1, 0.03 + 1e-5), n_#22_r(uv));
}

float n_#24_value(vec2 uv) {
    return smoothstep(0.0, max(0.08, 0.0 + 1e-5), n_#4_value(uv));
}

float n_#25_value(vec2 uv) {
    return n_#23_value(uv) * n_#24_value(uv);
}

vec4 n_#28_image(vec2 uv) {
    return mix(n_#27_image(uv), vec4(pv_borderColor(), 1.0), clamp(n_#25_value(uv), 0.0, 1.0));
}

float n_#5_value(vec2 uv) {
    float t = clamp(n_#4_value(uv), 0.0, 1.0);
    return t * t * t;
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) * pv_spin();
}

float n_#7_value(vec2 uv) {
    return n_#6_value(uv) * 0.017453;
}

float n_#8_value(vec2 uv) {
    return cos(n_#7_value(uv));
}

float n_#10_value(vec2 uv) {
    float t = clamp((n_#5_value(uv) - 0.0) / (1.0 - 0.0 + 1e-6), 0.0, 1.0);
    return mix(1.0, pv_flingSize(), t);
}

float n_#11_value(vec2 uv) {
    return n_#8_value(uv) * n_#10_value(uv);
}

float n_#9_value(vec2 uv) {
    return sin(n_#7_value(uv));
}

float n_#12_value(vec2 uv) {
    return n_#9_value(uv) * n_#10_value(uv);
}

float n_#13_value(vec2 uv) {
    return -n_#12_value(uv);
}

float n_#14_value(vec2 uv) {
    return n_#5_value(uv) * -0.25;
}

float n_#15_value(vec2 uv) {
    return n_#5_value(uv) * 1.4;
}

vec2 n_#16_p(vec2 uv) {
    return vec2(n_#14_value(uv), n_#15_value(uv));
}

vec2 n_#17_p(vec2 uv) {
    mat2 M = mat2(n_#11_value(uv), n_#12_value(uv), n_#13_value(uv), n_#11_value(uv));
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = vec2(0.5, 0.6);
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + n_#16_p(uv);
}

vec4 n_#18_image(vec2 uv) {
    vec2 p = n_#17_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return n_#1_image(p);
}

float n_#20_r(vec2 uv) {
    return texture(u_texture3, uv).r;
}

vec4 n_#29_image(vec2 uv) {
    return mix(n_#28_image(uv), n_#18_image(uv), clamp(n_#20_r(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#29_image(v_texCoord);
}
