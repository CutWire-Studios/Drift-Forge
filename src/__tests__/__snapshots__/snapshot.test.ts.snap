    {
      "path": "pass1.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform float u_time;
uniform float bps;
float pv_bps() { return bps; }

float n_#3_value(vec2 uv) {
    float x = u_time * pv_bps() + 0.0;
    return mix(0.0, 1.0, fract(x));
}

float n_#4_value(vec2 uv) {
    return 1.0 - n_#3_value(uv);
}

float n_#5_value(vec2 uv) {
    return pow(abs(n_#4_value(uv)), 3.0);
}

float n_#7_value(vec2 uv) {
    float t = clamp((n_#5_value(uv) - 0.0) / (1.0 - 0.0 + 1e-6), 0.0, 1.0);
    return mix(1.0, 1.08, t);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#9_image(vec2 uv) {
    vec2 p = (uv - vec2(0.5, 0.5)) / max(n_#7_value(uv), 0.0001) + vec2(0.5, 0.5);
    return n_#1_image(clamp(p, 0.0, 1.0));
}

void main() {
    fragColor = n_#9_image(v_texCoord);
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform vec2 u_resolution;
uniform float u_time;
uniform float bps;
uniform float punch;
uniform float split;
float pv_bps() { return bps; }
float pv_punch() { return punch; }
float pv_split() { return split; }

float n_#3_value(vec2 uv) {
    float x = u_time * pv_bps() + 0.0;
    return mix(0.0, 1.0, fract(x));
}

float n_#4_value(vec2 uv) {
    return 1.0 - n_#3_value(uv);
}

float n_#5_value(vec2 uv) {
    return pow(abs(n_#4_value(uv)), 3.0);
}

float n_#8_value(vec2 uv) {
    return n_#5_value(uv) * pv_split();
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) * pv_punch();
}

vec4 n_#10_image(vec2 uv) {
    vec2 ctr = vec2(0.5, 0.5);
    vec4 sum = vec4(0.0);
    for (int k = 0; k < 24; ++k) {
        float s = 1.0 - n_#6_value(uv) * float(k) / 23.0;
        sum += texture(u_currentTexture, ctr + (uv - ctr) * s);
    }
    return sum / 24.0;
}

vec4 n_#11_image(vec2 uv) {
    float a = radians(0.0);
    vec2 delta = vec2(cos(a), sin(a)) * n_#8_value(uv) / u_resolution;
    vec4 g = n_#10_image(uv);
    float r = n_#10_image(clamp(uv + delta, 0.0, 1.0)).r;
    float b = n_#10_image(clamp(uv - delta, 0.0, 1.0)).b;
    return vec4(r, g.g, b, g.a);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#2_mask(vec2 uv) {
    return driftMask(uv);
}

vec4 n_#12_image(vec2 uv) {
    return mix(n_#11_image(uv), n_#1_image(uv), clamp(n_#2_mask(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#12_image(v_texCoord);
}
",
