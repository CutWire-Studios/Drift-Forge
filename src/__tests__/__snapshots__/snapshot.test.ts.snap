   "source": "#version 330 core\\nin vec2 v_texCoord;\\nout vec4 fragColor;\\n\\nuniform sampler2D u_currentTexture;\\nuniform vec2 u_resolution;\\nuniform float u_time;\\nuniform float waveSize;\\nuniform float waveSpeed;\\nuniform float refraction;\\nuniform vec3 lightColor;\\nuniform float caustics;\\nfloat pv_waveSize() { return waveSize; }\\nfloat pv_waveSpeed() { return waveSpeed; }\\nfloat pv_refraction() { return refraction; }\\nvec3 pv_lightColor() { return lightColor; }\\nfloat pv_caustics() { return caustics; }\\nuniform float k_#3_spacing;\\nuniform float k_#2_seed;\\nuniform vec2 k_#4_b;\\nuniform float k_#6_s;\\nuniform float k_#8_a;\\nuniform float k_#7_spacing;\\nuniform float k_#10_inMin;\\nuniform float k_#10_inMax;\\nuniform float k_#10_outMin;\\nuniform float k_#10_outMax;\\nuniform float k_#11_amount;\\n\\nmat2 rot2(float a) {\\n    float c = cos(a);\\n    float s = sin(a);\\n    return mat2(c, s, -s, c);\\n}\\n\\nfloat hash21(vec2 p) {\\n    vec3 p3 = fract(vec3(p.xyx) * 0.1031);\\n    p3 += dot(p3, p3.yzx + 33.33);\\n    return fract((p3.x + p3.y) * p3.z);\\n}\\n\\nfloat valueNoise(vec2 p) {\\n    vec2 i = floor(p);\\n    vec2 f = fract(p);\\n    f = f * f * (3.0 - 2.0 * f);\\n    float a = hash21(i);\\n    float b = hash21(i + vec2(1.0, 0.0));\\n    float c = hash21(i + vec2(0.0, 1.0));\\n    float d = hash21(i + vec2(1.0, 1.0));\\n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\\n}\\n\\nfloat luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }\\n\\nvec4 n_#1_image(vec2 uv) {\\n    return texture(u_currentTexture, uv);\\n}\\n\\nvec2 n_#5_uv(vec2 uv) {\\n    return uv;\\n}\\n\\nfloat n_#2_value(vec2 uv) {\\n    return valueNoise(uv * vec2(u_resolution.x / max(u_resolution.y, 1.0), 1.0) * pv_waveSize() + vec2(u_time * pv_waveSpeed(), u_time * pv_waveSpeed() * 0.7) + vec2(k_#2_seed * 17.31, k_#2_seed * 7.77));\\n}\\n\\nvec2 n_#3_grad(vec2 uv) {\\n    vec2 h = max(k_#3_spacing, 0.01) / u_resolution;\\n    vec2 g = vec2(n_#2_value(uv + vec2(h.x, 0.0)) - n_#2_value(uv + vec2(-h.x, 0.0)), n_#2_value(uv + vec2(0.0, h.y)) - n_#2_value(uv + vec2(0.0, -h.y))) / (2.0 * h);\\n    return g;\\n}\\n\\nvec2 n_#4_p(vec2 uv) {\\n    return n_#3_grad(uv) * pv_refraction();\\n}\\n\\nvec2 n_#6_p(vec2 uv) {\\n    return n_#5_uv(uv) + n_#4_p(uv);\\n}\\n\\nvec4 n_#12_image(vec2 uv) {\\n    vec2 p = n_#6_p(uv);\\n    return n_#1_image(clamp(p, 0.0, 1.0));\\n}\\n\\nfloat n_#7_det(vec2 uv) {\\n    vec2 h = max(k_#7_spacing, 0.01) / u_resolution;\\n    vec2 jx = (n_#6_p((uv + vec2(h.x, 0.0))) - n_#6_p((uv + vec2(-h.x, 0.0)))) / (2.0 * h.x);\\n    vec2 jy = (n_#6_p((uv + vec2(0.0, h.y))) - n_#6_p((uv + vec2(0.0, -h.y)))) / (2.0 * h.y);\\n    return jx.x * jy.y - jy.x * jx.y;\\n}\\n\\nfloat n_#8_value(vec2 uv) {\\n    return k_#8_a / (abs(n_#7_det(uv)) < 1e-6 ? 1e-6 : n_#7_det(uv));\\n}\\n\\nfloat n_#9_value(vec2 uv) {\\n    return abs(n_#8_value(uv));\\n}\\n\\nfloat n_#10_value(vec2 uv) {\\n    float t = clamp((n_#9_value(uv) - k_#10_inMin) / (k_#10_inMax - k_#10_inMin + 1e-6), 0.0, 1.0);\\n    return mix(k_#10_outMin, k_#10_outMax, t);\\n}\\n\\nvec4 n_#11_image(vec2 uv) {\\n    vec4 col = vec4(vec3(n_#10_value(uv)), 1.0);\\n    vec3 tinted = luma(col) * vec4(pv_lightColor(), 1.0).rgb * 1.6;\\n    return vec4(mix(col.rgb, clamp(tinted, 0.0, 1.0), k_#11_amount), col.a);\\n}\\n\\nvec4 n_#13_image(vec2 uv) {\\n    vec4 b = n_#12_image(uv);\\n    vec4 l = n_#11_image(uv);\\n    vec3 rgb = 1.0 - (1.0 - b.rgb) * (1.0 - l.rgb);\\n    return vec4(mix(b.rgb, rgb, clamp(pv_caustics() * l.a, 0.0, 1.0)), b.a);\\n}\\n\\nvoid main() {\\n    fragColor = n_#13_image(v_texCoord);\\n}\\n",
