    {
      "path": "pass1.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 s_#2_0(vec2 uv) {
    float r = max(3.0, 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(1.0, 0.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += n_#1_image(uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#2_0(v_texCoord);
}
",
    },
    {
      "path": "pass2.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;

vec4 s_#2_1(vec2 uv) {
    float r = max(3.0, 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(0.0, 1.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#2_1(v_texCoord);
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform vec2 u_resolution;
uniform float contours;
uniform float lineWidth;
uniform vec3 lineColor;
float pv_contours() { return contours; }
float pv_lineWidth() { return lineWidth; }
vec3 pv_lineColor() { return lineColor; }

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#15_color(vec2 uv) {
    return vec4(pv_lineColor(), 1.0);
}

vec4 n_#2_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#3_l(vec2 uv) {
    return luma(n_#2_image(uv));
}

float n_#4_value(vec2 uv) {
    return n_#3_l(uv) * pv_contours();
}

float n_#5_value(vec2 uv) {
    return fract(n_#4_value(uv));
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) - 0.5;
}

float n_#7_value(vec2 uv) {
    return abs(n_#6_value(uv));
}

float n_#8_value(vec2 uv) {
    return 0.5 - n_#7_value(uv);
}

float n_#9_slope(vec2 uv) {
    vec2 h = max(1.0, 0.01) / u_resolution;
    vec2 g = vec2(n_#4_value(uv + vec2(h.x, 0.0)) - n_#4_value(uv + vec2(-h.x, 0.0)), n_#4_value(uv + vec2(0.0, h.y)) - n_#4_value(uv + vec2(0.0, -h.y))) / (2.0 * h);
    return length(g);
}

vec2 n_#10_size(vec2 uv) {
    return u_resolution;
}

float n_#11_y(vec2 uv) {
    return n_#10_size(uv).y;
}

float n_#12_value(vec2 uv) {
    return n_#9_slope(uv) / (abs(n_#11_y(uv)) < 1e-6 ? 1e-6 : n_#11_y(uv));
}

float n_#13_value(vec2 uv) {
    return n_#8_value(uv) / (abs(n_#12_value(uv)) < 1e-6 ? 1e-6 : n_#12_value(uv));
}

float n_#14_value(vec2 uv) {
    float t = clamp((n_#13_value(uv) - 0.4) / (pv_lineWidth() - 0.4 + 1e-6), 0.0, 1.0);
    return mix(1.0, 0.0, t);
}

vec4 n_#16_image(vec2 uv) {
    return mix(n_#1_image(uv), n_#15_color(uv), clamp(n_#14_value(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#16_image(v_texCoord);
}
