    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform float u_progress;

float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#2_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#3_random(vec2 uv) {
    vec2 n = max(floor(vec2(12.0, 7.0)), vec2(1.0));
    vec2 id = floor(uv * n);
    return hash21(id + 0.0 * 1.31);
}

float n_#4_mask(vec2 uv) {
    float x = clamp(n_#3_random(uv), 0.0, 1.0);
    
    float s = max(0.02, 0.0001);
    float front = mix(-s, 1.0 + s, u_progress);
    return 1.0 - smoothstep(front - s, front + s, x);
}

vec4 n_#5_image(vec2 uv) {
    return mix(n_#1_image(uv), n_#2_image(uv), clamp(n_#4_mask(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#5_image(v_texCoord);
}
