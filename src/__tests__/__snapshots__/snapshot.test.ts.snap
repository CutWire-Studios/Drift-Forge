    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float u_time;
uniform float bps;
float pv_bps() { return bps; }

float n_#3_value(vec2 uv) {
    float x = u_time * pv_bps() + 0.0;
    return mix(0.0, 14.0, exp(-fract(x) * 6.0));
}

float n_#2_value(vec2 uv) {
    float x = u_time * pv_bps() + 0.0;
    return mix(1.0, 1.25, exp(-fract(x) * 6.0));
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#4_image(vec2 uv) {
    vec2 p = (uv - vec2(0.5, 0.5)) / max(n_#2_value(uv), 0.0001) + vec2(0.5, 0.5);
    return n_#1_image(clamp(p, 0.0, 1.0));
}

vec4 n_#5_image(vec2 uv) {
    vec2 delta = (uv - vec2(0.5, 0.5)) * 2.0 * n_#3_value(uv) / u_resolution;
    vec4 g = n_#4_image(uv);
    float r = n_#4_image(clamp(uv + delta, 0.0, 1.0)).r;
    float b = n_#4_image(clamp(uv - delta, 0.0, 1.0)).b;
    return vec4(r, g.g, b, g.a);
}

void main() {
    fragColor = n_#5_image(v_texCoord);
}
