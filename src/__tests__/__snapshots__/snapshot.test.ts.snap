  ]
}
",
    },
    {
      "path": "pass1.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float u_progress;
uniform float growth;
uniform vec2 portalCentre;
uniform vec3 edgeColor;
float pv_growth() { return growth; }
vec2 pv_portalCentre() { return portalCentre; }
vec3 pv_edgeColor() { return edgeColor; }

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

float n_#3_mask(vec2 uv) {
    return driftMask(uv);
}

float n_#4_value(vec2 uv) {
    return u_progress;
}

float n_#5_value(vec2 uv) {
    return n_#4_value(uv) * n_#4_value(uv);
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) * pv_growth();
}

float n_#7_value(vec2 uv) {
    return exp(min(n_#6_value(uv), 80.0));
}

vec2 n_#8_p(vec2 uv) {
    mat2 M = mat2(n_#7_value(uv), 0.0, 0.0, n_#7_value(uv));
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = pv_portalCentre();
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + vec2(0.0, 0.0);
}

vec4 n_#9_image(vec2 uv) {
    vec2 p = n_#8_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return vec4(vec3(n_#3_mask(p)), 1.0);
}

float n_#10_r(vec2 uv) {
    return n_#9_image(uv).r;
}

float n_#11_slope(vec2 uv) {
    vec2 h = max(2.0, 0.01) / u_resolution;
    vec2 g = vec2(n_#10_r(uv + vec2(h.x, 0.0)) - n_#10_r(uv + vec2(-h.x, 0.0)), n_#10_r(uv + vec2(0.0, h.y)) - n_#10_r(uv + vec2(0.0, -h.y))) / (2.0 * h);
    return length(g);
}

vec2 n_#12_size(vec2 uv) {
    return u_resolution;
}

float n_#13_y(vec2 uv) {
    return n_#12_size(uv).y;
}

float n_#14_value(vec2 uv) {
    return n_#11_slope(uv) / (abs(n_#13_y(uv)) < 1e-6 ? 1e-6 : n_#13_y(uv));
}

float n_#15_value(vec2 uv) {
    return smoothstep(0.02, max(0.2, 0.02 + 1e-5), n_#14_value(uv));
}

vec4 n_#16_image(vec2 uv) {
    return mix(vec4(0.0, 0.0, 0.0, 1.0), vec4(pv_edgeColor(), 1.0), clamp(n_#15_value(uv), 0.0, 1.0));
}

vec4 s_#17_0(vec2 uv) {
    vec4 col = n_#16_image(uv);
    return vec4(max(col.rgb - vec3(0.0), 0.0) / max(1.0 - 0.0, 0.0001), 1.0);
}

void main() {
    fragColor = s_#17_0(v_texCoord);
}
",
    },
    {
      "path": "pass2.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;

vec4 s_#17_1(vec2 uv) {
    float r = max(12.0, 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(1.0, 0.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#17_1(v_texCoord);
}
",
    },
    {
      "path": "pass3.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;

vec4 s_#17_2(vec2 uv) {
    float r = max(12.0, 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(0.0, 1.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#17_2(v_texCoord);
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform sampler2D u_texture2;
uniform vec2 u_resolution;
uniform float u_progress;
uniform float growth;
uniform vec2 portalCentre;
uniform vec3 edgeColor;
uniform float edgeGlow;
float pv_growth() { return growth; }
vec2 pv_portalCentre() { return portalCentre; }
vec3 pv_edgeColor() { return edgeColor; }
float pv_edgeGlow() { return edgeGlow; }

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#2_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#3_mask(vec2 uv) {
    return driftMask(uv);
}

float n_#4_value(vec2 uv) {
    return u_progress;
}

float n_#5_value(vec2 uv) {
    return n_#4_value(uv) * n_#4_value(uv);
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) * pv_growth();
}

float n_#7_value(vec2 uv) {
    return exp(min(n_#6_value(uv), 80.0));
}

vec2 n_#8_p(vec2 uv) {
    mat2 M = mat2(n_#7_value(uv), 0.0, 0.0, n_#7_value(uv));
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = pv_portalCentre();
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + vec2(0.0, 0.0);
}

vec4 n_#9_image(vec2 uv) {
    vec2 p = n_#8_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return vec4(vec3(n_#3_mask(p)), 1.0);
}

float n_#10_r(vec2 uv) {
    return n_#9_image(uv).r;
}

float n_#18_value(vec2 uv) {
    return smoothstep(0.85, max(1.0, 0.85 + 1e-5), n_#4_value(uv));
}

float n_#19_value(vec2 uv) {
    return max(n_#10_r(uv), n_#18_value(uv));
}

vec4 n_#20_image(vec2 uv) {
    return mix(n_#1_image(uv), n_#2_image(uv), clamp(n_#19_value(uv), 0.0, 1.0));
}

float n_#11_slope(vec2 uv) {
    vec2 h = max(2.0, 0.01) / u_resolution;
    vec2 g = vec2(n_#10_r(uv + vec2(h.x, 0.0)) - n_#10_r(uv + vec2(-h.x, 0.0)), n_#10_r(uv + vec2(0.0, h.y)) - n_#10_r(uv + vec2(0.0, -h.y))) / (2.0 * h);
    return length(g);
}

vec2 n_#12_size(vec2 uv) {
    return u_resolution;
}

float n_#13_y(vec2 uv) {
    return n_#12_size(uv).y;
}

float n_#14_value(vec2 uv) {
    return n_#11_slope(uv) / (abs(n_#13_y(uv)) < 1e-6 ? 1e-6 : n_#13_y(uv));
}

float n_#15_value(vec2 uv) {
    return smoothstep(0.02, max(0.2, 0.02 + 1e-5), n_#14_value(uv));
}

vec4 n_#16_image(vec2 uv) {
    return mix(vec4(0.0, 0.0, 0.0, 1.0), vec4(pv_edgeColor(), 1.0), clamp(n_#15_value(uv), 0.0, 1.0));
}

vec4 n_#17_glow(vec2 uv) {
    return vec4(clamp(texture(u_texture2, uv).rgb * vec4(1.0, 1.0, 1.0, 1.0).rgb * pv_edgeGlow(), 0.0, 1.0), 1.0);
}

float n_#21_value(vec2 uv) {
    return 1.0 - n_#18_value(uv);
}

vec4 n_#22_image(vec2 uv) {
    vec4 b = n_#20_image(uv);
    vec4 l = n_#17_glow(uv);
    vec3 rgb = min(b.rgb + l.rgb, 1.0);
    return vec4(mix(b.rgb, rgb, clamp(n_#21_value(uv) * l.a, 0.0, 1.0)), b.a);
}

void main() {
