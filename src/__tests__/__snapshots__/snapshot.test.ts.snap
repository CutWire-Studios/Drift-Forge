}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform sampler2D u_texture2;
uniform sampler2D u_texture3;
uniform vec2 u_resolution;
uniform float u_time;
uniform float wobbleSpeed;
uniform float wobble;
uniform float tilt;
uniform float stickerSize;
uniform float shadow;
uniform vec3 borderColor;
float pv_wobbleSpeed() { return wobbleSpeed; }
float pv_wobble() { return wobble; }
float pv_tilt() { return tilt; }
float pv_stickerSize() { return stickerSize; }
float pv_shadow() { return shadow; }
vec3 pv_borderColor() { return borderColor; }

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

mat2 rot2(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat2(c, s, -s, c);
}

vec4 n_#25_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#26_image(vec2 uv) {
    vec4 col = n_#25_image(uv);
    vec3 rgb = (col.rgb - 0.5) * 1.0 + 0.5 + -0.15;
    return vec4(clamp(rgb, 0.0, 1.0), col.a);
}

vec4 n_#16_image(vec2 uv) {
    return texture(u_texture1, uv);
}

vec2 n_#19_uv(vec2 uv) {
    return uv;
}

vec2 n_#20_p(vec2 uv) {
    return n_#19_uv(uv) + vec2(-0.012, -0.022);
}

vec4 n_#21_image(vec2 uv) {
    vec2 p = n_#20_p(uv);
    return n_#16_image(clamp(p, 0.0, 1.0));
}

float n_#22_r(vec2 uv) {
    return n_#21_image(uv).r;
}

float n_#23_value(vec2 uv) {
    return smoothstep(0.02, max(0.5, 0.02 + 1e-5), n_#22_r(uv));
}

float n_#24_value(vec2 uv) {
    return n_#23_value(uv) * pv_shadow();
}

vec4 n_#27_image(vec2 uv) {
    return mix(n_#26_image(uv), vec4(0.0, 0.0, 0.0, 1.0), clamp(n_#24_value(uv), 0.0, 1.0));
}

float n_#17_r(vec2 uv) {
    return n_#16_image(uv).r;
}

float n_#18_value(vec2 uv) {
    return smoothstep(0.03, max(0.1, 0.03 + 1e-5), n_#17_r(uv));
}

vec4 n_#28_image(vec2 uv) {
    return mix(n_#27_image(uv), vec4(pv_borderColor(), 1.0), clamp(n_#18_value(uv), 0.0, 1.0));
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_texture2, uv);
}

float n_#3_value(vec2 uv) {
    float x = u_time * pv_wobbleSpeed() + 0.0;
    return mix(-1.0, 1.0, 0.5 - 0.5 * cos(x * 6.2832));
}

float n_#4_value(vec2 uv) {
    return n_#3_value(uv) * pv_wobble();
}

float n_#5_value(vec2 uv) {
    return n_#4_value(uv) + pv_tilt();
}

float n_#6_value(vec2 uv) {
    return n_#5_value(uv) * 0.017453;
}

float n_#7_value(vec2 uv) {
    return cos(n_#6_value(uv));
}

float n_#9_value(vec2 uv) {
    return n_#7_value(uv) * pv_stickerSize();
}

float n_#8_value(vec2 uv) {
    return sin(n_#6_value(uv));
}

float n_#10_value(vec2 uv) {
    return n_#8_value(uv) * pv_stickerSize();
}

float n_#11_value(vec2 uv) {
    return -n_#10_value(uv);
}

vec2 n_#12_p(vec2 uv) {
    mat2 M = mat2(n_#9_value(uv), n_#10_value(uv), n_#11_value(uv), n_#9_value(uv));
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = vec2(0.5, 0.6);
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + vec2(0.0, 0.0);
}

vec4 n_#13_image(vec2 uv) {
    vec2 p = n_#12_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return n_#1_image(p);
}

float n_#15_r(vec2 uv) {
    return texture(u_texture3, uv).r;
}

vec4 n_#29_image(vec2 uv) {
    return mix(n_#28_image(uv), n_#13_image(uv), clamp(n_#15_r(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#29_image(v_texCoord);
}
