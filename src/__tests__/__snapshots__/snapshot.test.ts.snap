  "files": [
    {
      "path": "transition.json",
      "text": "{
  "id": "#0",
  "displayName": "Silhouette portal",
  "category": "geometric",
  "order": 1000,
  "description": "The person's outline becomes a window into the next clip and grows exponentially until it fills the frame, traced by a neon edge.",
  "audioCurve": "crossfade",
  "requires": "mask",
  "parameters": [
    {
      "identifier": "growth",
      "displayName": "Growth",
      "type": "float",
      "minValue": 1,
      "maxValue": 6,
      "defaultValue": 3.5
    },
    {
      "identifier": "portalCentre",
      "displayName": "Grow from",
      "type": "point",
      "minValue": [
        0,
        0
      ],
      "maxValue": [
        1,
        1
      ],
      "defaultValue": [
        0.5,
        0.4
      ]
    },
    {
      "identifier": "edgeColor",
      "displayName": "Edge colour",
      "type": "color",
      "defaultValue": "#4dfcff"
    },
    {
      "identifier": "edgeGlow",
      "displayName": "Edge glow",
      "type": "float",
      "minValue": 0,
      "maxValue": 4,
      "defaultValue": 1.6
    }
  ],
  "pipeline": {
    "intermediateBuffers": [
      {
        "id": "buf0",
        "scale": 1
      },
      {
        "id": "buf1",
        "scale": 1
      }
    ],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "pass1.frag",
        "inputs": [
          {
            "type": "source_texture",
            "index": 0
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf0"
        }
      },
      {
        "passIndex": 1,
        "fragmentShader": "pass2.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "buf0"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf1"
        }
      },
      {
        "passIndex": 2,
        "fragmentShader": "pass3.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "buf1"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf0"
        }
      },
      {
        "passIndex": 3,
        "fragmentShader": "main.frag",
        "inputs": [
