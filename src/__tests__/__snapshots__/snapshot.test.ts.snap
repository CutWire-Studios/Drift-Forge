  "files": [
    {
      "path": "effect.json",
      "text": "{
  "id": "#0",
  "displayName": "Clone parade",
  "category": "impact",
  "order": 1000,
  "description": "Two glowing copies of the person step out to either side, scaled from their feet with a linear transform.",
  "backend": "gpu",
  "requires": "mask",
  "parameters": [
    {
      "identifier": "swayRate",
      "displayName": "Sway speed",
      "type": "float",
      "minValue": 0,
      "maxValue": 3,
      "defaultValue": 0.5
    },
    {
      "identifier": "spread",
      "displayName": "Spread",
      "type": "float",
      "minValue": 0,
      "maxValue": 0.5,
      "defaultValue": 0.28
    },
    {
      "identifier": "cloneSize",
      "displayName": "Clone size",
      "type": "float",
      "minValue": 0.5,
      "maxValue": 1.2,
      "defaultValue": 0.9
    },
    {
      "identifier": "cloneTint",
      "displayName": "Clone tint",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.45
    },
    {
      "identifier": "rightColor",
      "displayName": "Right clone",
      "type": "color",
      "defaultValue": "#ff3d7f"
    },
    {
      "identifier": "leftColor",
      "displayName": "Left clone",
      "type": "color",
      "defaultValue": "#3dd2ff"
    },
    {
      "identifier": "haloSize",
      "displayName": "Halo size",
      "type": "float",
      "minValue": 2,
      "maxValue": 48,
      "defaultValue": 18
    },
    {
      "identifier": "haloColor",
      "displayName": "Halo",
      "type": "color",
      "defaultValue": "#ff4f6d"
    },
    {
      "identifier": "halo",
      "displayName": "Halo glow",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.9
    }
  ],
  "pipeline": {
    "intermediateBuffers": [
      {
        "id": "buf0",
        "scale": 1
      },
      {
        "id": "buf1",
        "scale": 1
      }
    ],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "pass1.frag",
        "inputs": [
          {
            "type": "source_texture"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf0"
        }
      },
      {
        "passIndex": 1,
        "fragmentShader": "pass2.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "buf0"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf1"
        }
      },
      {
        "passIndex": 2,
        "fragmentShader": "pass3.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "buf1"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "buf0"
        }
      },
      {
        "passIndex": 3,
        "fragmentShader": "main.frag",
        "inputs": [
          {
            "type": "source_texture"
          },
          {
            "type": "buffer",
            "id": "buf0"
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  },
  "nextFeatures": [
    "node:clip_mask",
    "requires:mask"
  ]
}
",
    },
    {
      "path": "pass1.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float u_time;
uniform float swayRate;
uniform float spread;
uniform float cloneSize;
float pv_swayRate() { return swayRate; }
float pv_spread() { return spread; }
float pv_cloneSize() { return cloneSize; }

mat2 rot2(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat2(c, s, -s, c);
}

float n_#2_mask(vec2 uv) {
    return driftMask(uv);
}

float n_#3_value(vec2 uv) {
    float x = u_time * pv_swayRate() + 0.0;
    return mix(0.8, 1.0, 0.5 - 0.5 * cos(x * 6.2832));
}

float n_#4_value(vec2 uv) {
    return pv_spread() * n_#3_value(uv);
}

vec2 n_#5_p(vec2 uv) {
    return vec2(n_#4_value(uv), 0.0);
}

vec2 n_#6_p(vec2 uv) {
    return n_#5_p(uv) * -1.0;
}

vec2 n_#7_p(vec2 uv) {
    mat2 M = mat2(pv_cloneSize(), 0.0, 0.0, pv_cloneSize());
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = vec2(0.5, 1.0);
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + n_#6_p(uv);
}

vec4 n_#11_image(vec2 uv) {
    vec2 p = n_#7_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return vec4(vec3(n_#2_mask(p)), 1.0);
}

vec2 n_#8_p(vec2 uv) {
    mat2 M = mat2(pv_cloneSize(), 0.0, 0.0, pv_cloneSize());
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = vec2(0.5, 1.0);
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + n_#5_p(uv);
}

vec4 n_#12_image(vec2 uv) {
    vec2 p = n_#8_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return vec4(vec3(n_#2_mask(p)), 1.0);
}

vec4 n_#17_image(vec2 uv) {
    vec4 b = n_#11_image(uv);
    vec4 l = n_#12_image(uv);
    vec3 rgb = min(b.rgb + l.rgb, 1.0);
    return vec4(mix(b.rgb, rgb, clamp(1.0 * l.a, 0.0, 1.0)), b.a);
}

void main() {
    fragColor = n_#17_image(v_texCoord);
}
",
    },
    {
      "path": "pass2.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float haloSize;
float pv_haloSize() { return haloSize; }

vec4 s_#18_0(vec2 uv) {
    float r = max(pv_haloSize(), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(1.0, 0.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#18_0(v_texCoord);
}
",
    },
    {
      "path": "pass3.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform vec2 u_resolution;
uniform float haloSize;
float pv_haloSize() { return haloSize; }

vec4 s_#18_1(vec2 uv) {
    float r = max(pv_haloSize(), 0.0);
    float sigma = max(r * 0.5, 0.0001);
    float stepPx = max(r / 16.0, 1.0);
    vec2 texel = vec2(0.0, 1.0) / u_resolution;
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int k = -16; k <= 16; ++k) {
        float o = float(k) * stepPx;
        if (abs(o) > r + 0.001) continue;
        float w = exp(-0.5 * o * o / (sigma * sigma));
        sum += texture(u_currentTexture, uv + texel * o) * w;
        wsum += w;
    }
    return sum / wsum;
}

void main() {
    fragColor = s_#18_1(v_texCoord);
}
",
    },
    {
      "path": "main.frag",
      "text": "#version 330 core
in vec2 v_texCoord;
out vec4 fragColor;

uniform sampler2D u_currentTexture;
uniform sampler2D u_texture1;
uniform vec2 u_resolution;
uniform float u_time;
uniform float swayRate;
uniform float spread;
uniform float cloneSize;
uniform float cloneTint;
uniform vec3 rightColor;
uniform vec3 leftColor;
uniform vec3 haloColor;
uniform float halo;
float pv_swayRate() { return swayRate; }
float pv_spread() { return spread; }
float pv_cloneSize() { return cloneSize; }
float pv_cloneTint() { return cloneTint; }
vec3 pv_rightColor() { return rightColor; }
vec3 pv_leftColor() { return leftColor; }
vec3 pv_haloColor() { return haloColor; }
float pv_halo() { return halo; }

float luma(vec4 c) { return dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)); }

mat2 rot2(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat2(c, s, -s, c);
}

vec4 n_#1_image(vec2 uv) {
    return texture(u_currentTexture, uv);
}

vec4 n_#18_image(vec2 uv) {
    return texture(u_texture1, uv);
}

float n_#19_r(vec2 uv) {
    return n_#18_image(uv).r;
}

vec4 n_#20_image(vec2 uv) {
    return mix(vec4(0.0, 0.0, 0.0, 1.0), vec4(pv_haloColor(), 1.0), clamp(n_#19_r(uv), 0.0, 1.0));
}

vec4 n_#21_image(vec2 uv) {
    vec4 b = n_#1_image(uv);
    vec4 l = n_#20_image(uv);
    vec3 rgb = 1.0 - (1.0 - b.rgb) * (1.0 - l.rgb);
    return vec4(mix(b.rgb, rgb, clamp(pv_halo() * l.a, 0.0, 1.0)), b.a);
}

float n_#3_value(vec2 uv) {
    float x = u_time * pv_swayRate() + 0.0;
    return mix(0.8, 1.0, 0.5 - 0.5 * cos(x * 6.2832));
}

float n_#4_value(vec2 uv) {
    return pv_spread() * n_#3_value(uv);
}

vec2 n_#5_p(vec2 uv) {
    return vec2(n_#4_value(uv), 0.0);
}

vec2 n_#6_p(vec2 uv) {
    return n_#5_p(uv) * -1.0;
}

vec2 n_#7_p(vec2 uv) {
    mat2 M = mat2(pv_cloneSize(), 0.0, 0.0, pv_cloneSize());
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = vec2(0.5, 1.0);
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + n_#6_p(uv);
}

vec4 n_#9_image(vec2 uv) {
    vec2 p = n_#7_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return n_#1_image(p);
}

vec4 n_#13_image(vec2 uv) {
    vec4 col = n_#9_image(uv);
    vec3 tinted = luma(col) * vec4(pv_rightColor(), 1.0).rgb * 1.6;
    return vec4(mix(col.rgb, clamp(tinted, 0.0, 1.0), pv_cloneTint()), col.a);
}

float n_#2_mask(vec2 uv) {
    return driftMask(uv);
}

vec4 n_#11_image(vec2 uv) {
    vec2 p = n_#7_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return vec4(vec3(n_#2_mask(p)), 1.0);
}

float n_#15_r(vec2 uv) {
    return n_#11_image(uv).r;
}

vec4 n_#22_image(vec2 uv) {
    return mix(n_#21_image(uv), n_#13_image(uv), clamp(n_#15_r(uv), 0.0, 1.0));
}

vec2 n_#8_p(vec2 uv) {
    mat2 M = mat2(pv_cloneSize(), 0.0, 0.0, pv_cloneSize());
    float det = determinant(M);
    M = mat2(M[1][1], -M[0][1], -M[1][0], M[0][0]) / (abs(det) < 1e-6 ? 1e-6 : det);
    float asp = u_resolution.x / max(u_resolution.y, 1.0);
    vec2 o = vec2(0.5, 1.0);
    vec2 q = (uv - o) * vec2(asp, 1.0);
    return (M * q) / vec2(asp, 1.0) + o + n_#5_p(uv);
}

vec4 n_#10_image(vec2 uv) {
    vec2 p = n_#8_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return n_#1_image(p);
}

vec4 n_#14_image(vec2 uv) {
    vec4 col = n_#10_image(uv);
    vec3 tinted = luma(col) * vec4(pv_leftColor(), 1.0).rgb * 1.6;
    return vec4(mix(col.rgb, clamp(tinted, 0.0, 1.0), pv_cloneTint()), col.a);
}

vec4 n_#12_image(vec2 uv) {
    vec2 p = n_#8_p(uv);
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return vec4(0.0);
    return vec4(vec3(n_#2_mask(p)), 1.0);
}

float n_#16_r(vec2 uv) {
    return n_#12_image(uv).r;
}

vec4 n_#23_image(vec2 uv) {
    return mix(n_#22_image(uv), n_#14_image(uv), clamp(n_#16_r(uv), 0.0, 1.0));
}

vec4 n_#24_image(vec2 uv) {
    return mix(n_#23_image(uv), n_#1_image(uv), clamp(n_#2_mask(uv), 0.0, 1.0));
}

void main() {
    fragColor = n_#24_image(v_texCoord);
}
