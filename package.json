{
  "name": "drift-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build && tsc -p server/tsconfig.json --noEmit",
    "lint": "oxlint src server scripts",
    "test": "vitest run && FORGE_DEV=1 bun test server",
    "check-shaders": "vite-node scripts/check-shaders.ts",
    "server": "bun server/index.ts",
    "dev:server": "FORGE_DEV=1 PORT=8787 bun --watch server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.12",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
